<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ro.mpp.triathlon.controller.LoginController"
      spacing="10"
      alignment="CENTER"
      prefWidth="300"
      prefHeight="250">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Autentificare Arbitru" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="usernameField" promptText="Username"/>
    <PasswordField fx:id="passwordField" promptText="Parolă"/>

    <Button text="Login" onAction="#handleLogin" maxWidth="Infinity" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>

</VBox>